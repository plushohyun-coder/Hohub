# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Web/API port on the NAS. Synology DSM already uses 5000/5001, so the default is 5080.
PORT=5080

# PostgreSQL holding the Hohub schema (database/schema.sql + database/migrations/*.sql).
# Required: login accounts live in this database.
# Use a read-only DB user if the AI assistant is the main consumer.
DATABASE_URL=postgres://hohub:CHANGE_ME@127.0.0.1:5432/hohub

# Claude API key - enables the AI assistant panel.
ANTHROPIC_API_KEY=

# Build-time only: fine-grained GitHub token with read-only "Contents" access to
# plushohyun-coder/plus-erp-ai-client. Used to install the AI client during the build.
GITHUB_TOKEN=

# Read-only data API for the AI assistant. Listens on 127.0.0.1 only (default: PORT + 1).
INTERNAL_API_PORT=5081

# Set to 1 if a reverse proxy (e.g. Synology's) sits in front and terminates HTTPS.
TRUST_PROXY_HOPS=0
