# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Web/API port on the NAS. Synology DSM already uses 5000/5001, so the default is 5080.
PORT=5080

# PostgreSQL holding the Hohub schema (database/schema.sql).
# The ERP screens create records, so this user needs write access.
DATABASE_URL=postgres://hohub:CHANGE_ME@127.0.0.1:5432/hohub

# Claude API key - enables the AI assistant panel.
ANTHROPIC_API_KEY=

# Build-time only, and only if vendor/ is empty: fine-grained GitHub token with read-only
# "Contents" access to plushohyun-coder/plus-erp-ai-client. Leave blank when you put the
# AI client ZIP into vendor/ (see vendor/README.md).
GITHUB_TOKEN=
