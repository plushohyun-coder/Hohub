PORT=5000
# PostgreSQL connection. Required for login; without it the API stays locked.
DATABASE_URL=
# plus-erp-ai-client: Claude API key enables the AI assistant at /api/ai
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
PLUS_ERP_AI_MODEL=
# Optional: ERP API the assistant reads from (default: the read-only internal API below)
ERP_API_BASE_URL=
# Read-only data API for the AI assistant, 127.0.0.1 only (default PORT + 1)
INTERNAL_API_PORT=
# Number of reverse proxies in front of the app (0 = none)
TRUST_PROXY_HOPS=0
# Extra origins allowed to POST (comma-separated), e.g. https://erp.example.com
ALLOWED_ORIGINS=
